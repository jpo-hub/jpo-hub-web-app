generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Filiere {
  uid   String @id @default(uuid())
  label String @unique

  Candidat_Filiere Candidat_Filiere[]

  Reponse_Filiere Reponse_Filiere[]
  Atelier_Filiere Atelier_Filiere[]

  filiereStats Stats?
}

model Response {
  uid        String @id @default(uuid())
  label      String
  questionId String

  question Question @relation(fields: [questionId], references: [uid])

  Reponse_Filiere Reponse_Filiere[]
}

model Question {
  uid      String     @id @default(uuid())
  label    String     @unique
  multiple Boolean    @default(false)
  Response Response[]
}

model Reponse_Filiere {
  reponseId String
  filiereId String
  score     Int    @default(0)

  response Response @relation(fields: [reponseId], references: [uid])
  filiere  Filiere  @relation(fields: [filiereId], references: [uid])

  @@unique([reponseId, filiereId])
}

model Candidat {
  uid          String   @id @default(uuid())
  codeCandidat Int      @unique @default(autoincrement())
  firstname    String
  lastname     String
  email        String   @unique
  ageRange     String
  appointment  Boolean
  consentement Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Candidat_Filiere Candidat_Filiere[]

  Atelier_Candidat Atelier_Candidat[]
}

model Candidat_Filiere {
  candidatId String
  filiereId  String
  score      Int    @default(0)

  candidat Candidat @relation(fields: [candidatId], references: [uid])
  filiere  Filiere  @relation(fields: [filiereId], references: [uid])

  @@unique([candidatId, filiereId])
}

model Atelier {
  uid            String   @id @default(uuid())
  label          String   @unique
  imageUrl       String
  description    String
  draft          Boolean  @default(true)
  createAt       DateTime @default(now())
  updateAt       DateTime @updatedAt
  dockerfilelink String

  Atelier_Candidat Atelier_Candidat[]
  Atelier_Filiere  Atelier_Filiere[]
}

model Atelier_Filiere {
  atelierId String
  filiereId String
  score     Int    @default(0)

  atelier Atelier @relation(fields: [atelierId], references: [uid])
  filiere Filiere @relation(fields: [filiereId], references: [uid])

  @@unique([atelierId, filiereId])
}

model Atelier_Candidat {
  atelierId  String
  candidatId String

  atelier  Atelier  @relation(fields: [atelierId], references: [uid])
  candidat Candidat @relation(fields: [candidatId], references: [uid])

  @@unique([atelierId, candidatId])
}

model Admin {
  uid       String @id @default(uuid())
  firstname String
  password  String
  lastname  String
  role      String
  email     String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stats {
  uid            String @id @default(uuid())
  filiereId      String @unique
  selectionCount Int    @default(0)
  views          Int    @default(0)

  filiere Filiere @relation(fields: [filiereId], references: [uid])
}

model StatsSnapshot {
  uid       String   @id @default(uuid())
  label     String
  data      Json
  timestamp DateTime @default(now())
}
